# Telegram
BOT_TOKEN=

# AI provider: openai | anthropic
# openai = OpenAI-совместимый шлюз (например, Timeweb AI Gateway), отдающий Claude
AI_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=anthropic/claude-haiku-4-5
ANTHROPIC_API_KEY=

# Local SQLite storage
DB_PATH=data/bot.db
CACHE_TTL_HOURS=6
ANTI_FLOOD_COOLDOWN_SECONDS=3
CLAUDE_MODEL=claude-sonnet-5
